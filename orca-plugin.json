{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "cv-hub",
  "name": "CV Hub",
  "version": "0.6.2",
  "description": "Browse CV Hub repositories and pull requests in Orca: read diffs, checks and review history, submit reviews, and search code. Signs in with CV Hub in your browser.",
  "license": "MIT",
  "repository": "https://github.com/lamtuanvu/cv-hub-orca-plugin",
  "engines": {
    "orca": ">=1.4.248"
  },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "cv-hub",
        "title": "CV Hub",
        "icon": "code",
        "entry": "panel.html",
        "ui": "html"
      }
    ],
    "commands": [
      {
        "id": "cvhub.signIn",
        "title": "CV Hub: Sign in"
      },
      {
        "id": "cvhub.signOut",
        "title": "CV Hub: Sign out"
      },
      {
        "id": "cvhub.refresh",
        "title": "CV Hub: Refresh open pull requests"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ],
    "settings": [
      {
        "key": "apiOrigin",
        "title": "CV Hub API origin",
        "type": "string",
        "default": "https://api.hub.controlvector.io",
        "description": "The origin of the CV Hub API, such as https://api.hub.example.com — not the web app's address and not an /api path. HTTPS is required except for loopback development servers."
      }
    ],
    "statusBarItems": [
      {
        "id": "cvhub-status",
        "icon": "code",
        "text": "CV Hub",
        "tone": "neutral",
        "tooltip": "CV Hub",
        "command": "cvhub.signIn"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
